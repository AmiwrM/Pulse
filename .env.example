# Pulse — environment overrides
# Copy to .env and adjust for your deployment.
# Secrets here override panel settings on startup.

PULSE_PORT=8080
PULSE_VERSION=1.6.3
TZ=Asia/Tehran

# Optional: use a go module mirror if proxy.golang.org is unreachable.
# GOPROXY=https://mirrors.aliyun.com/goproxy/,direct

# Real Xray handshake engine used by Docker Compose.
XRAY_VERSION=v26.11.9
# XRAY_DOWNLOAD_URL=https://your-mirror.example/Xray-linux-64.zip

# PULSE_TELEGRAM_TOKEN=
# PULSE_TELEGRAM_CHAT=
# PULSE_CF_TOKEN=
# PULSE_WEBHOOK_URL=
